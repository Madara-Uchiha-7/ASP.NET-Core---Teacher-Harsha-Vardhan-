﻿<div class="list-container">
    <h3>Title from Index View : @ViewData["ListTitle"]</h3>
    @{
        ViewBag.ListTitle =
            "This title is updated by the Partial View. Its a copy, it will not change the Index/About View Title";
    }
    <h3>@ViewData["ListTitle"]</h3>
    <ul class="list">
        @foreach (string city in ViewBag.ListItems)
        {
            <li>@city</li>
        }
    </ul>
</div>